#!/usr/bin/env python3
"""
ncweb - a small local web UI for ncsync: see both sides' changes, pick
what syncs, choose the folders.

    python3 _sync/ncweb [--no-browser]

Serves on 127.0.0.1 only, with a one-time token in the URL. Nothing is
exposed to the network. Requires nothing but Python 3.8+ and rclone.
"""
import ast
import calendar
import collections
import concurrent.futures
import hashlib
import http.server
import json
import os
import re
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
import unicodedata
import urllib.parse
import webbrowser

SELF = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(SELF)
FILES = os.path.join(REPO, "files")
CONF = os.path.join(SELF, "rclone.conf")
FILTERS = os.path.join(SELF, "filters.txt")
FOLDERS = os.path.join(SELF, "folders.txt")
STATE = os.path.join(SELF, "state")
MARKERS = os.path.join(STATE, "initialised")
NCSYNC = os.path.join(SELF, "ncsync")
LOGS = os.path.join(SELF, "logs")
ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
REPO_ID = os.path.join(REPO, ".repo-id")

TOKEN = secrets.token_urlsafe(18)

# ----------------------------------------------------------------- helpers


def have_rclone():
    return shutil.which("rclone") is not None


def slug(p):
    return p.replace("/", "_").replace(" ", "_")


def read_selection():
    if not os.path.exists(FOLDERS):
        return []
    out = []
    with open(FOLDERS, encoding="utf-8") as fh:
        for line in fh:
            line = re.sub(r"#.*$", "", line).strip()
            if line:
                out.append(line)
    return out


def write_selection(paths):
    header = []
    if os.path.exists(FOLDERS):
        with open(FOLDERS, encoding="utf-8") as fh:
            for line in fh:
                if line.strip() == "" or line.lstrip().startswith("#"):
                    header.append(line.rstrip("\n"))
                else:
                    break
    while header and header[-1].strip() == "":
        header.pop()
    body = "\n".join(header) + "\n\n" + "\n".join(paths) + "\n"
    tmp = FOLDERS + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(body)
    os.replace(tmp, FOLDERS)


def overlaps(paths):
    """Return a (parent, child) pair if one selection contains another."""
    for a in paths:
        for b in paths:
            if a != b and b.startswith(a.rstrip("/") + "/"):
                return (a, b)
    return None


def last_run(path):
    m = os.path.join(MARKERS, slug(path))
    if os.path.exists(m):
        try:
            with open(m, encoding="utf-8") as fh:
                return fh.read().strip()
        except OSError:
            return "?"
    return None


def rclone(args, timeout=180):
    cmd = ["rclone", "--config", CONF] + args
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    return p.returncode, p.stdout, p.stderr


# --------------------------------------------------------------- conflicts

# rclone renames a losing copy with --conflict-suffix, e.g.
#   shot.exr  ->  shot.exr.conflict-2026-09-181
# and with --conflict-loser pathname the last digit says where it came from:
# 1 the server (bisync's Path1), 2 this drive (Path2). Match loosely so older
# spellings (..path1, .conflict1) show up too, just without an origin.
# ponytail: name matching, not a conflict database - rclone owns the truth.
CONFLICT_RE = re.compile(r"\.\.?conflict[^./]*", re.I)
ORIGIN_RE = re.compile(r"conflict-\d{4}-\d\d-\d\d([12])$")
ORIGIN = {"1": "server", "2": "drive"}


def under_files(rel):
    """Resolve a client-supplied relative path, refusing anything outside FILES."""
    full = os.path.realpath(os.path.join(FILES, rel))
    root = os.path.realpath(FILES)
    if full != root and not full.startswith(root + os.sep):
        return None
    return full


def version(rel, origin):
    try:
        st = os.stat(os.path.join(FILES, rel))
    except OSError:
        return None
    return {"path": rel, "size": st.st_size, "mtime": st.st_mtime * 1000,
            "origin": origin}


def find_conflicts(limit=500):
    """Conflict copies grouped under the file they belong to, the file itself
    first when it still exists: [{base, versions: [{path, size, mtime, origin}]}]."""
    groups = {}
    for root, dirs, names in os.walk(FILES):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        for name in names:
            m = CONFLICT_RE.search(name)
            if name.startswith(".") or not m:
                continue
            rel = os.path.relpath(os.path.join(root, name), FILES)
            base = os.path.join(os.path.dirname(rel), CONFLICT_RE.sub("", name))
            o = ORIGIN_RE.search(m.group(0))
            v = version(rel, ORIGIN[o.group(1)] if o else "copy")
            if v:
                groups.setdefault(base, []).append(v)
    out = []
    for base in sorted(groups)[:limit]:
        cur = version(base, "current")
        out.append({"base": base, "versions": ([cur] if cur else []) +
                    sorted(groups[base], key=lambda v: v["path"])})
    return out, len(groups) > limit


def keep_version(rel):
    """Keep one version of a conflicted file under the original name and delete
    the other copies beside it. Returns an error message, or None."""
    keep = under_files(rel)
    if not keep or not os.path.isfile(keep):
        return "no such file"
    d, name = os.path.split(keep)
    orig = CONFLICT_RE.sub("", name)
    others = [os.path.join(d, n) for n in os.listdir(d) if n != name
              and CONFLICT_RE.search(n) and CONFLICT_RE.sub("", n) == orig]
    if orig == name and not others:
        return "no conflict copies of that file"
    if orig != name:
        os.replace(keep, os.path.join(d, orig))
    for o in others:
        os.remove(o)
    return None


# ------------------------------------------------------------------ review
#
# The page shows what rclone bisync would find on its next run: each side as
# it is now, against that same side at the last sync (state/*.path1.lst is
# the server, *.path2.lst this drive). Unlike bisync it then applies only the
# ticked changes, and writes the listings back so that every path both sides
# now agree on counts as synced while every other path keeps its old entry:
# an unticked change stays a change, like an unstaged file in git. ncsync in
# the terminal reads the same listings and carries on from there.

E = collections.namedtuple("E", "name dir size ns line")  # line: as read from a listing
WINDOW = 2 * 10**9  # ncsync's --modify-window 2s

# Everything must match ncsync, the name encoding exactly: otherwise a file
# called "12:30.pdf" looks deleted on one side and new on the other.
with open(NCSYNC, encoding="utf-8") as _fh:
    ENC = re.search(r'--local-encoding "([^"]+)"', _fh.read()).group(1)


def flags():
    """ncsync's rclone flags, minus the bisync-only ones."""
    return ["--config", CONF, "--local-encoding", ENC, "--modify-window", "2s",
            "--transfers", os.environ.get("NCSYNC_TRANSFERS", "8"),
            "--checkers", os.environ.get("NCSYNC_CHECKERS", "16"),
            "--retries", "3", "--low-level-retries", "10", "--contimeout", "30s",
            "--timeout", "120s", "--webdav-nextcloud-chunk-size", "32Mi",
            "--disable-http2"]


TIME_RE = re.compile(
    r"(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)(?:\.(\d+))?(Z|[+-]\d\d:?\d\d)$")


def to_ns(s):
    """rclone's RFC 3339 or a bisync listing's time -> UTC nanoseconds."""
    y, mo, d, h, mi, sec, frac, off = TIME_RE.match(s).groups()
    t = calendar.timegm((int(y), int(mo), int(d), int(h), int(mi), int(sec)))
    if off != "Z":
        off = off.replace(":", "")
        t -= int(off[0] + "1") * (int(off[1:3]) * 3600 + int(off[3:]) * 60)
    return t * 10**9 + int((frac or "").ljust(9, "0")[:9])


def from_ns(ns):
    s, f = divmod(ns, 10**9)
    return "%04d-%02d-%02dT%02d:%02d:%02d.%09d+0000" % (time.gmtime(s)[:6] + (f,))


ZERO = to_ns("0001-01-01T00:00:00Z")  # a listing entry with no date on record

# cmd/bisync/listing.go: lineRegex
LST_RE = re.compile(r'^([-d]) +(-?\d+) (\S+) (\S+) '
                    r'(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{9}[+-]\d{4}) (".+")$')


def nfc(name):
    # macOS can hand back a decomposed "ü" where the server has a composed
    # one; bisync matches the two up, so must we
    return unicodedata.normalize("NFC", name)


def load_listing(path):
    """One side of bisync's last-sync listing as {name: E}; None if there is none."""
    try:
        fh = open(path, encoding="utf-8")
    except FileNotFoundError:
        return None
    out = {}
    with fh:
        for line in fh:
            line = line.rstrip("\n")
            m = LST_RE.match(line)
            if not m or m.group(4) != "-":
                continue  # bisync ignores these lines too
            flag, size, _, _, ts, q = m.groups()
            try:
                name = json.loads(q)
            except ValueError:
                name = ast.literal_eval(q)  # Go quoting JSON lacks: \a \v \x01
            out[nfc(name)] = E(name, flag == "d", int(size), to_ns(ts), line)
    return out


def save_listing(path, entries):
    """Write one side back the way bisync does (listing.go: save)."""
    with open(path + ".tmp", "w", encoding="utf-8") as fh:
        fh.write("# bisync listing v1 from %s\n" % from_ns(time.time_ns()))
        for e in sorted(entries.values(), key=lambda e: e.name):
            fh.write((e.line or "%s %8d - - %s %s" % (
                "d" if e.dir else "-", e.size, from_ns(e.ns),
                json.dumps(e.name, ensure_ascii=False))) + "\n")
    os.replace(path + ".tmp", path)


def session(folder):
    """(cwd, local root, state-file prefix), exactly as ncsync hands them to bisync."""
    name = lambda p2: ("nc:%s..local:%s" % (folder, p2)).replace(":", "_").replace("/", "_")  # noqa: E731
    runin, p2 = FILES, folder
    if len(name(p2)) > 235:
        local = os.path.join(FILES, folder)
        runin, p2 = os.path.dirname(local), os.path.basename(local)
    if len(name(p2)) > 235:
        return None
    return runin, p2, os.path.join(STATE, name(p2))


def lsjson(root, cwd):
    """One side as it is now, filtered like bisync, as {name: E}."""
    p = subprocess.run(
        ["rclone", "lsjson", "-R", "--no-mimetype", "--filter-from", FILTERS, root]
        + flags(), cwd=cwd, capture_output=True, encoding="utf-8", errors="replace")
    if p.returncode:
        raise RuntimeError("could not list %s: %s" % (root, p.stderr.strip()[-300:]))
    return {nfc(i["Path"]): E(i["Path"], i["IsDir"], -1 if i["IsDir"] else i["Size"],
                              to_ns(i["ModTime"]), None) for i in json.loads(p.stdout)}


def current(folder, runin, p2, prefix):
    """(server, drive) as they are now - after ncsync's check on the drive's dates."""
    try:
        with open(prefix + ".drive-date") as fh:
            moved = int(os.stat(REPO_ID).st_mtime) - int(fh.read())
    except (OSError, ValueError):
        moved = 0
    if moved:
        raise RuntimeError(
            "this drive's file dates moved by %+ds since the last sync (daylight "
            "saving? another OS?), so every file would look changed. Shift them "
            "by %+ds before syncing - see 'Dates moved' in the README." % (moved, -moved))
    os.makedirs(os.path.join(FILES, folder), exist_ok=True)
    with concurrent.futures.ThreadPoolExecutor(2) as ex:
        srv = ex.submit(lsjson, "nc:" + folder, runin)
        loc = ex.submit(lsjson, p2, runin)
        return srv.result(), loc.result()


def differs(a, b):
    """bisync's size-and-date test (compare.go: sizeDiffers, timeDiffers)."""
    if a.dir or b.dir:
        return a.dir != b.dir
    if a.size >= 0 and b.size >= 0 and a.size != b.size:
        return True
    return ZERO not in (a.ns, b.ns) and abs(a.ns - b.ns) >= WINDOW


def change(old, now):
    if old is None:
        return "new" if now else None
    if now is None:
        return "deleted"
    return "modified" if differs(old, now) else None


def info(e):
    return e and {"size": e.size, "mtime": e.ns // 10**6, "dir": e.dir}


def diff(b1, b2, srv, loc):
    """Each path that changed on either side since the last sync and where the
    two sides now disagree. Both sides changed = a conflict: bisync would copy
    a modified file over a deleted one, but here you decide."""
    out = []
    for k in sorted(set(b1) | set(b2) | set(srv) | set(loc)):
        s, l = srv.get(k), loc.get(k)
        cs, cl = change(b1.get(k), s), change(b2.get(k), l)
        if not (cs or cl) or (s and l and not differs(s, l)) or not (s or l):
            continue
        e = l or s
        out.append({"key": k, "path": e.name, "dir": e.dir, "server": cs,
                    "local": cl, "s": info(s), "l": info(l),
                    "b": info(b1.get(k) or b2.get(k))})
    return pair_moves(out)


def pair_moves(changes):
    """A file gone from one path and one new at another, on the same side, same
    size to the byte and same date: a move, done on the other side as a rename
    instead of a delete and a fresh upload. Only unique matches pair, and only
    where the other side still has the old file unchanged and nothing at the
    new path, so the rename leaves both sides equal. No hashes to compare:
    the listings hold none (ncsync compares size and date), and Nextcloud has
    checksums for some files only. A re-render gets a new date."""
    for side, mine, theirs, other in (("local", "l", "s", "server"),
                                      ("server", "s", "l", "local")):
        gone = [c for c in changes if c[side] == "deleted" and not c[other]
                and not c["dir"] and c[theirs] and c[theirs]["size"] > 0]
        new = [c for c in changes if c[side] == "new" and not c[other]
               and not c["dir"] and c[mine]["size"] > 0]
        # same second, no window: a move keeps the date, and the server stores seconds
        same = lambda a, b: a["size"] == b["size"] and a["mtime"] // 1000 == b["mtime"] // 1000  # noqa: E731
        hits = {}
        for n in new:
            g = [g for g in gone if same(g[theirs], n[mine])]
            if len(g) == 1:
                hits.setdefault(g[0]["key"], []).append((n, g[0]))
        for pairs in hits.values():
            if len(pairs) == 1:
                n, g = pairs[0]
                n[side], n["from"], n["fromPath"] = "moved", g["key"], g["path"]
                changes.remove(g)
    return changes


def reconcile(b1, b2, srv, loc):
    """The next baseline: whatever both sides now agree on is synced; every
    other path keeps its last-sync entry, so it still shows up as a change."""
    n1, n2 = {}, {}
    for k in set(b1) | set(b2) | set(srv) | set(loc):
        s, l = srv.get(k), loc.get(k)
        if s and l and not differs(s, l):
            n1[k], n2[k] = s, l
        elif s or l:
            if k in b1:
                n1[k] = b1[k]
            if k in b2:
                n2[k] = b2[k]
    return n1, n2


def parents(key):
    while "/" in key:
        key = key.rsplit("/", 1)[0]
        yield key


def outermost(pairs):
    """Deleted folders not inside another deleted folder (rmdirs is recursive)."""
    keys = {k for k, _ in pairs}
    return [n for k, n in pairs if not any(p in keys for p in parents(k))]


def innermost(dirs, files):
    """New folders nothing else creates: no new subfolder, no file copied in."""
    covered = {p for k, _ in dirs + files for p in parents(k)}
    return [n for k, n in dirs if k not in covered]


REVIEW = {"folders": {}, "copies": [], "more": False, "at": None}


def review(folder):
    s = session(folder)
    if not s:
        return {"folder": folder, "error": "too deep for rclone's state files - "
                "sync a shallower parent folder instead"}
    try:
        srv, loc = current(folder, *s)
    except Exception as exc:  # noqa: BLE001
        return {"folder": folder, "error": str(exc)}
    b1 = load_listing(s[2] + ".path1.lst") or {}
    b2 = load_listing(s[2] + ".path2.lst") or {}
    return {"folder": folder, "synced": last_run(folder),
            "changes": diff(b1, b2, srv, loc)}


def scan_task(job):
    for folder in read_selection():
        job.record("checking " + folder)
        REVIEW["folders"][folder] = r = review(folder)
        job.record("  " + (("! " + r["error"]) if "error" in r
                           else "%d changes" % len(r["changes"])))
    REVIEW["copies"], REVIEW["more"] = find_conflicts()
    REVIEW["at"] = time.time() * 1000
    return 0


def apply_task(job, picks):
    """picks: {folder: {name: "up" | "down"}}. Make each picked path on the
    other side match this drive (up) or the server (down), then record in
    bisync's listings whatever both sides now agree on."""
    failed = False
    for folder, want in picks.items():
        job.record("==> " + folder)
        s = session(folder)
        if not s or os.path.exists(s[2] + ".lck"):
            job.record("! skipped - " + ("too deep for rclone's state files" if not s else
                       "rclone bisync is running on it, or crashed: " + s[2] + ".lck"))
            failed = True
            continue
        runin, p2, prefix = s
        b1 = load_listing(prefix + ".path1.lst") or {}
        b2 = load_listing(prefix + ".path2.lst") or {}
        try:
            srv, loc = current(folder, *s)
        except Exception as exc:  # noqa: BLE001
            job.record("! " + str(exc))
            failed = True
            continue

        # Only what still looks the way it did on the page: a file saved again
        # since the check is left for the next look, not overwritten blind.
        seen = {c["key"]: c for c in REVIEW["folders"].get(folder, {}).get("changes", [])}
        now = {c["key"]: c for c in diff(b1, b2, srv, loc)}
        todo = collections.defaultdict(list)  # (way, op) -> [(key, name)]
        for k, way in want.items():
            c, was = now.get(k), seen.get(k)
            if not c or not was or (c["s"], c["l"], c.get("from")) != \
                    (was["s"], was["l"], was.get("from")):
                job.record("skipped, changed since the check: " + k)
                continue
            src, dst = (loc, srv) if way == "up" else (srv, loc)
            if c.get("from"):
                if c["local" if way == "up" else "server"] == "moved":
                    todo[way, "move"].append((k, (dst[c["from"]].name, src[k].name)))
            elif k in src:
                todo[way, "mkdir" if src[k].dir else "copy"].append((k, src[k].name))
            else:
                todo[way, "rmdirs" if dst[k].dir else "delete"].append((k, dst[k].name))

        ok = True
        ends = {"up": (p2, "nc:" + folder), "down": ("nc:" + folder, p2)}
        # ponytail: one rclone per moved file; a renamed folder of 2,000
        # frames takes minutes, not the hours of sending it again. Moving the
        # folder in one go is the upgrade if that ever drags.
        for way, (a, b) in ends.items():
            job.phase = way
            for _, (old, new) in todo[way, "move"]:
                if job.rclone(["moveto", b + "/" + old, b + "/" + new], runin):
                    job.record(new + ": Moved")
                else:
                    ok = False
        for way, (a, b) in ends.items():
            job.phase = way
            if todo[way, "copy"]:
                ok &= job.rclone(["copy", a, b, "--no-traverse"], runin,
                                 [n for _, n in todo[way, "copy"]])
        for way, (a, b) in ends.items():
            job.phase = way
            if todo[way, "delete"]:
                ok &= job.rclone(["delete", b], runin, [n for _, n in todo[way, "delete"]])
        for way, (a, b) in ends.items():
            job.phase = way
            for n in outermost(todo[way, "rmdirs"]):
                ok &= job.rclone(["rmdirs", b + "/" + n], runin)
            for n in innermost(todo[way, "mkdir"], todo[way, "copy"]):
                ok &= job.rclone(["mkdir", b + "/" + n], runin)
        job.phase = None

        # Record the outcome even after a failure or Stop: whatever did
        # arrive on both sides is synced, the rest stays a change.
        try:
            srv, loc = current(folder, *s)
        except Exception as exc:  # noqa: BLE001
            job.record("! could not check the result: %s" % exc)
            failed = True
            continue
        n1, n2 = reconcile(b1, b2, srv, loc)
        if n1:  # bisync refuses an empty listing
            save_listing(prefix + ".path1.lst", n1)
            save_listing(prefix + ".path2.lst", n2)
            # bisync records the filters' hash only on --resync, and refuses
            # to run without it - after a first sync made here, for one
            if not os.path.exists(FILTERS + ".md5"):
                with open(FILTERS, "rb") as fh, open(FILTERS + ".md5", "w") as out:
                    out.write(hashlib.md5(fh.read()).hexdigest())
            with open(prefix + ".drive-date", "w") as fh:
                fh.write("%d\n" % os.stat(REPO_ID).st_mtime)
            os.makedirs(MARKERS, exist_ok=True)
            with open(os.path.join(MARKERS, slug(folder)), "w", encoding="utf-8") as fh:
                fh.write(time.strftime("%Y-%m-%d %H:%M") + "\n")
        left = diff(n1, n2, srv, loc)
        REVIEW["folders"][folder] = {"folder": folder, "synced": last_run(folder),
                                     "changes": left}
        job.record("    %s - %d changes left" % ("done" if ok else "FAILED", len(left)))
        failed |= not ok
    REVIEW["copies"], REVIEW["more"] = find_conflicts()
    REVIEW["at"] = time.time() * 1000
    return 1 if failed else 0


def resync_task(job):
    return job.run(["bash", NCSYNC, "--resync"], SELF,
                   dict(os.environ, TERM="dumb", NCSYNC_JSON="1"))


# --------------------------------------------------------------------- jobs

class Job:
    """One thing at a time: checking for changes, syncing, or a fresh sync."""

    def __init__(self):
        self.lines = []
        self.running = False
        self.kind = None
        self.phase = None  # "up" / "down" while a sync moves files that way
        self.proc = None
        self.stopping = False
        self.lock = threading.Lock()
        self.rc = None
        self.stats = None
        self.log = None

    def start(self, kind, task, log=True):
        """Run task(self) in a thread; what it returns is the exit code."""
        with self.lock:
            if self.running:
                return False
            self.lines, self.running, self.kind, self.phase = [], True, kind, None
            self.rc, self.stats, self.stopping = None, None, False
            if log:
                os.makedirs(LOGS, exist_ok=True)
                self.log = open(os.path.join(
                    LOGS, time.strftime("%Y-%m-%d_%H-%M-%S") + "-web.log"),
                    "a", encoding="utf-8")

        def run():
            try:
                self.rc = task(self) or 0
            except Exception as exc:  # noqa: BLE001
                self.record("! ncweb error: %s" % exc)
                self.rc = 1
            finally:
                with self.lock:
                    self.running = False
                    self.stats = None
                    if self.log:
                        self.log.close()
                        self.log = None

        threading.Thread(target=run, daemon=True).start()
        return True

    def run(self, argv, cwd, env=None):
        """A child process with its output streamed to the page; its exit code."""
        if self.stopping:
            return 1
        with self.lock:
            self.stats = None  # not the last run's totals under the next one's column
        self.proc = subprocess.Popen(
            argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            encoding="utf-8", errors="replace", bufsize=1, env=env)
        for raw in self.proc.stdout:
            self.absorb(raw.rstrip("\n"))
        return self.proc.wait()

    def rclone(self, args, cwd, names=None):
        """rclone with ncsync's flags and live progress; names go to --files-from-raw
        (raw: a file called '#1.exr' is a file, not a comment). True if it worked."""
        extra = ["--use-json-log", "--stats", "1s", "--stats-log-level", "NOTICE",
                 "--log-level", "INFO"]
        if names is None:
            return self.run(["rclone"] + args + flags() + extra, cwd) == 0
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".lst",
                                         delete=False) as fh:
            fh.write("".join(n + "\n" for n in names))
        try:
            return self.run(["rclone"] + args + flags() + extra +
                            ["--files-from-raw", fh.name], cwd) == 0
        finally:
            os.remove(fh.name)

    def record(self, line):
        """Append to self.lines; the log file gets the same text. Caller holds no lock."""
        line = ANSI_RE.sub("", line)
        with self.lock:
            self.lines.append(line)
            if self.log:
                try:
                    self.log.write(line + "\n")
                    self.log.flush()
                except OSError:
                    self.log = None

    def absorb(self, line):
        """rclone emits JSON with --use-json-log; ncsync's own echoes are plain."""
        if line[:1] == "{":
            try:
                obj = json.loads(line)
            except ValueError:
                obj = None
            if isinstance(obj, dict):
                st = obj.get("stats")
                if isinstance(st, dict):
                    with self.lock:
                        self.stats = st
                    return
                msg = obj.get("msg")
                if msg is not None:
                    if obj.get("object"):  # "Copied (new)" - which file is on the side
                        msg = "%s: %s" % (obj["object"], msg)
                    lvl = obj.get("level", "")
                    for m in str(msg).splitlines():
                        m = m.rstrip()
                        if m:
                            self.record(
                                ("! " + m) if lvl in ("error", "critical") else m)
                    return
        self.record(line)

    def tail(self, offset):
        with self.lock:
            return (self.lines[offset:], len(self.lines), self.running,
                    self.rc, self.stats, self.kind, self.phase)

    def stop(self):
        self.stopping = True
        if self.proc and self.running:
            try:
                self.proc.terminate()
            except OSError:
                pass


