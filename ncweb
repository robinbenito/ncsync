  return nodes.get(p);
}

function fmt(b) {
  if (b === null || b === undefined) return "";
  const u = ["B", "KB", "MB", "GB", "TB"];
  let i = 0, n = b;
  while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
  return n.toFixed(n < 10 && i > 1 ? 1 : 0) + " " + u[i];
}

function esc(s) {
  return String(s).replace(/[&<>"]/g, c =>
    ({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"}[c]));
}

function dur(sec) {
  sec = Math.round(sec);
  if (sec < 60) return sec + "s";
  if (sec < 3600) return Math.floor(sec / 60) + "m " + (sec % 60) + "s";
  return Math.floor(sec / 3600) + "h " + Math.floor((sec % 3600) / 60) + "m";
}

function when(ms) {
  const d = new Date(ms), o = {day: "numeric", month: "short", hour: "2-digit", minute: "2-digit"};
  if (d.getFullYear() !== new Date().getFullYear()) o.year = "numeric";
  return d.toLocaleString(undefined, o);
}

const base = p => p.slice(p.lastIndexOf("/") + 1);

// ----------------------------------------------------------------- changes
// One item per changed path. Its way: "up" makes the server match this
// drive, "down" the other way round, "" leaves it for later. Nothing is
// ever decided for a conflict.
let review = {folders: [], copies: []};
let items = [];
const choice = new Map();   // item id -> way, where you changed the default
const open = new Map();     // tree node id -> expanded
let busy = false;

function flatten() {
  items = [];
  for (const f of review.folders) for (const c of f.changes || []) {
    const side = c.local && c.server ? "both" : c.local ? "local" : "server";
    items.push({i: items.length, id: f.folder + "\u0000" + c.key, folder: f.folder, c, side,
                def: side === "local" ? "up" : side === "server" ? "down" : ""});
  }
}
const way = it => choice.has(it.id) ? choice.get(it.id) : it.def;

function pick(list, on) {
  for (const it of list) {
    const w = on ? it.def : "";
    if (w === it.def) choice.delete(it.id); else choice.set(it.id, w);
  }
}

// Each column is a tree of folders; a chain of folders holding nothing but
// one folder is squashed into a single row.
function build(list, col) {
  const roots = new Map(), mk = (name, id) => ({name, id, kids: new Map(), item: null});
  for (const it of list) {
    let n = roots.get(it.folder);
    if (!n) roots.set(it.folder, n = mk(it.folder, col + it.folder));
    for (const part of it.c.path.split("/")) {
      if (!n.kids.has(part)) n.kids.set(part, mk(part, n.id + "/" + part));
      n = n.kids.get(part);
    }
    n.item = it;
  }
  const squash = n => {
    for (const k of n.kids.values()) {
      while (k.kids.size === 1) {
        const only = k.kids.values().next().value;
        if (!only.kids.size || (k.item && !only.item)) break;
        if (k.item) k.item.implied = true;
        k.name += "/" + only.name; k.id = only.id; k.kids = only.kids; k.item = only.item;
      }
      if (k.item && k.kids.size) k.item.implied = true;   // a folder that goes with its contents
      squash(k);
    }
  };
  for (const r of roots.values()) squash(r);
  return [...roots.values()];
}

function under(n) {
  if (!n.all) {
    n.all = n.item && !n.item.implied ? [n.item] : [];
    for (const k of n.kids.values()) for (const it of under(k)) n.all.push(it);
  }
  return n.all;
}

const kindOf = (it, col) => col === "L" ? it.c.local : it.c.server;
const verOf = (it, col) => col === "L" ? it.c.l : it.c.s;

function badge(it, col) {
  const k = kindOf(it, col);
  return '<span class="kind k-' + k + '">' +
    (it.c.dir ? {new: "new folder", deleted: "folder deleted"}[k] || k : k) + "</span>";
}

function meta(it, col) {
  const v = verOf(it, col), b = it.c.b;
  if (it.c.dir) return "";
  if (!v) return b ? "was " + fmt(b.size) : "";
  return fmt(v.size) + (b && !b.dir && b.size !== v.size ? " (was " + fmt(b.size) + ")" : "") +
    " · " + when(v.mtime);
}

function totals(list, col) {
  const n = {modified: 0, new: 0, moved: 0, deleted: 0};
  let bytes = 0, dirs = 0;
  for (const it of list) {
    if (it.c.dir) { dirs++; continue; }
    n[kindOf(it, col)]++;
    const v = verOf(it, col);
    if (v && !it.c.from) bytes += v.size;   // a move sends nothing
  }
  const out = [];
  for (const k in n) if (n[k]) out.push('<span class="k-' + k + '">' + n[k].toLocaleString() + " " + k + "</span>");
  if (dirs) out.push(dirs + (dirs === 1 ? " folder" : " folders"));
  if (bytes) out.push(fmt(bytes));
  return out.join(" · ");
}

// Say only what the move changed: the folder, the name, or both.
function movedFrom(c) {
  const dir = p => p.slice(0, p.lastIndexOf("/") + 1);
  if (base(c.fromPath) === base(c.path)) return "from " + (dir(c.fromPath) || "the top folder");
  if (dir(c.fromPath) === dir(c.path)) return "renamed from " + base(c.fromPath);
  return "from " + c.fromPath;
}

const RP = '<span class="rp" hidden><span class="pbar sm"><i></i></span><span class="rpt"></span></span>';

function column(col, box, list) {
  const nodes = [], rows = [];
  const kids = n => [...n.kids.values()].sort((a, b) =>
    (b.kids.size > 0) - (a.kids.size > 0) || a.name.localeCompare(b.name));
  const walk = (n, depth) => {
    if (!n.kids.size) {
      const it = n.item, on = !!way(it), gone = !verOf(it, col);
      rows.push('<div class="row' + (on ? "" : " off") + '" style="--d:' + depth + '">' +
        '<input type="checkbox" data-i="' + it.i + '"' + (on ? " checked" : "") +
        (busy ? " disabled" : "") + ' aria-label="sync ' + esc(n.name) + '"><span class="body">' +
        '<span class="nm' + (gone ? " gone" : "") + '" title="' + esc(it.c.path) + '">' +
        esc(n.name) + "</span>" + badge(it, col) +
        '<span class="meta">' + meta(it, col) + "</span>" +
        (it.c.from ? '<span class="from" title="from ' + esc(it.c.fromPath) + '">' + esc(movedFrom(it.c)) + "</span>" : "") +
        RP + "</span></div>");
      return;
    }
    const all = under(n), on = all.filter(way).length, i = nodes.push(n) - 1;
    const isOpen = open.has(n.id) ? open.get(n.id) : depth === 0 || all.length <= 12;
    rows.push('<div class="row dir' + (on ? "" : " off") + '" style="--d:' + depth + '">' +
      '<input type="checkbox" data-n="' + i + '"' + (on === all.length ? " checked" : "") +
      (on && on < all.length ? " data-mixed" : "") + (busy ? " disabled" : "") +
      ' aria-label="sync everything in ' + esc(n.name) + '">' +
      '<button class="tw" data-t="' + i + '" aria-expanded="' + isOpen + '">' + (isOpen ? "▾" : "▸") + "</button>" +
      '<span class="body"><span class="nm" data-t="' + i + '" title="' + esc(n.name) + '"><bdi>' +
      esc(n.name) + "/</bdi></span>" + (n.item ? badge(n.item, col) : "") +
      '<span class="meta">' + totals(all, col) + "</span>" + RP + "</span></div>");
    if (isOpen) for (const k of kids(n)) walk(k, depth + 1);
  };
  for (const r of build(list, col)) walk(r, 0);
  box._nodes = nodes;
  box.innerHTML = rows.join("") ||
    '<div class="empty">Nothing changed here since the last sync.</div>';
  box.querySelectorAll("[data-mixed]").forEach(cb => { cb.indeterminate = true; });
}

function listen(box) {
  box.addEventListener("click", e => {
    const t = e.target.closest("[data-t]");
    if (!t) return;
    const n = box._nodes[+t.dataset.t], row = t.closest(".row");
    open.set(n.id, row.querySelector(".tw").getAttribute("aria-expanded") !== "true");
    draw();
  });
  box.addEventListener("change", e => {
    const cb = e.target;
    if (cb.dataset.i) pick([items[+cb.dataset.i]], cb.checked);
    else if (cb.dataset.n) pick(under(box._nodes[+cb.dataset.n]), cb.checked);
    draw();
  });
}

// A three-way switch: the server's version, leave it, or this drive's.
// w is the way it shows, m(way) the small print under each side.
function seg(name, data, label, w, m) {
  const opt = (value, who) =>
    '<label><input type="radio" name="' + name + '" ' + data + ' value="' + value + '"' +
    (w === value ? " checked" : "") + (busy ? " disabled" : "") + "><b>" + who + "</b>" +
    (value ? '<span class="m">' + m(value) + "</span>" : "") + "</label>";
  return '<div class="seg" role="radiogroup" aria-label="' + esc(label) + '">' +
    opt("down", "Server") + opt("", "Later") + opt("up", "This drive") + "</div>";
}

// The side whose copy is newer, as a way: "up", "down", or "" when neither is.
function newerWay(it) {
  const l = it.c.l, s = it.c.s;
  return l && s && Math.abs(l.mtime - s.mtime) >= 2000 ? (l.mtime > s.mtime ? "up" : "down") : "";
}

// One row per conflict: the name, its folder underneath unless the row sits
// under that folder's own (inGroup), and the switch.
function conflictCard(it, inGroup) {
  const l = it.c.l, s = it.c.s, newer = newerWay(it);
  const same = l && s && !l.dir && !s.dir && l.size === s.size;
  const full = it.folder + "/" + it.c.path, i = full.lastIndexOf("/");
  const note = (inGroup ? [] : ["in " + esc(full.slice(0, i))])
    .concat(same ? ["same size on both sides, maybe the same file"] : []).join(" · ");
  return '<div class="cf c3"><div class="cfh"><div class="cfn">' + esc(full.slice(i + 1)) + "</div>" +
    (note ? '<div class="cfp">' + note + "</div>" : "") + "</div>" +
    seg("c" + it.i, 'data-i="' + it.i + '"', "which version of " + full.slice(i + 1), way(it), v => {
      const e = v === "up" ? l : s;
      return (!e ? "deleted" : e.dir ? "folder" : fmt(e.size) + " · " + when(e.mtime)) +
        (newer === v ? " · newer" : "");
    }) + "</div>";
}

// Conflicts are grouped by the folder they are in. A folder with several gets
// a row of its own on top: its switch decides them all in one go, and each
// file's switch underneath still overrides it. Twelve or fewer start open,
// like the folders in the two columns.
let groups = [];

function group(cs) {
  const by = new Map();
  for (const it of cs) {
    const full = it.folder + "/" + it.c.path, dir = full.slice(0, full.lastIndexOf("/"));
    if (!by.has(dir)) by.set(dir, {dir, id: "C" + dir, items: []});
    by.get(dir).items.push(it);
  }
  return [...by.values()];
}

function conflictGroup(g, n) {
  const k = g.items.length;
  if (k === 1) return conflictCard(g.items[0]);
  const ways = new Set(g.items.map(way)), i = g.dir.lastIndexOf("/");
  const isOpen = open.has(g.id) ? open.get(g.id) : k <= 12;
  return '<div class="cg"><div class="cf c3 cgh">' +
    '<button class="tw" data-c="' + n + '" aria-expanded="' + isOpen + '">' + (isOpen ? "▾" : "▸") + "</button>" +
    '<div class="cfh"><div class="cfn" data-c="' + n + '">' + esc(g.dir.slice(i + 1)) + "/</div>" +
    '<div class="cfp">' + k + " files" + (ways.size > 1 ? ", decided one by one" : "") +
    (i > 0 ? " · in " + esc(g.dir.slice(0, i)) : "") + "</div></div>" +
    seg("g" + n, 'data-g="' + n + '"', "which version of every file in " + g.dir,
        ways.size === 1 ? [...ways][0] : null, v => {
      const newer = g.items.filter(it => newerWay(it) === v).length;
      return newer === k ? "newer in all " + k : newer ? "newer in " + newer + " of " + k : "";
    }) + "</div>" + (isOpen ? g.items.map(it => conflictCard(it, true)).join("") : "") + "</div>";
}

// A card leads with the file's name; the folder it is in goes underneath.
function where(full) {
  const i = full.lastIndexOf("/");
  return ['<div class="cfn">' + esc(full.slice(i + 1)) + "</div>",
          '<div class="cfp">in ' + esc(full.slice(0, i)) + "</div>"];
}

const WHO = {server: "The server's version", drive: "This drive's version",
             current: "The file as it is now", copy: "A saved copy"};

function copyCard(g) {
  const [name, dir] = where(g.base), bn = base(g.base);
  const newest = v => g.versions.every(o => o === v || v.mtime - o.mtime >= 2000);
  return '<div class="cf">' + name + '<div class="vs">' + g.versions.map(v =>
      '<div class="ver"><b>' + WHO[v.origin] +
      (newest(v) ? '<span class="tag">newest</span>' : "") + "</b>" +
      '<span class="meta">' + fmt(v.size) + " · saved " + when(v.mtime) + "</span>" +
      (v.origin === "current" ? "" : '<span class="fnm" title="' + esc(v.path) + '">as ' +
        esc(base(v.path).startsWith(bn) ? "…" + base(v.path).slice(bn.length) : base(v.path)) + "</span>") +
      '<button data-keep="' + esc(v.path) + '" data-who="' + esc(WHO[v.origin]) + '"' +
      (busy ? " disabled" : "") + ">Keep this one</button></div>").join("") + "</div>" + dir + "</div>";
}

function decide() {
  const cs = items.filter(it => it.side === "both"), cp = review.copies || [];
  let h = "";
  groups = group(cs);
  if (cs.length) {
    h += "<h3>" + cs.length + (cs.length === 1 ? " file" : " files") +
      " changed on both sides</h3><p>Pick the version that wins; it replaces the other when you sync. " +
      "Left on Later, neither side is touched." +
      (groups.length < cs.length ? " A folder's switch decides every file in it." : "") + "</p>" +
      groups.map(conflictGroup).join("");
  }
  if (cp.length) {
    h += (cs.length ? '<h3 style="margin-top:16px">' : "<h3>") +
      cp.length + (cp.length === 1 ? " file" : " files") + " with conflict copies" +
      (review.more ? " (first 500 shown)" : "") + "</h3>" +
      "<p>An earlier sync found these changed on both sides and kept every version, " +
      "renamed. Keep one: it goes back under the original name, and the other copies are " +
      "deleted from this drive. The server follows on your next sync.</p>" +
      cp.map(copyCard).join("");
  }
  el("decide").className = h ? "decide" : "";
  el("decide").innerHTML = h;
}

function summary() {
  const h = review.folders.map(f => "<div><b>" + esc(f.folder) + "</b> &nbsp;" +
    (f.error ? '<span class="err">' + esc(f.error) + "</span>"
      : f.synced ? '<span class="count">last synced ' + esc(f.synced) + "</span>"
      : '<span class="count">never synced — below is what the first sync would do</span>') +
    "</div>");
  if (review.at) {
    const clean = !items.length && !(review.copies || []).length && !review.folders.some(f => f.error);
    h.push('<div class="count">checked ' + when(review.at) +
      (clean ? ' &nbsp;<span class="ok">Everything is in sync.</span>' : "") + "</div>");
  }
  if (!saved) h.push("<div>No folders picked yet. Tick the ones you want under " +
    "<b>Folders on the server</b>, then <b>Save list</b>.</div>");
  el("summary").innerHTML = h.join("");
}

function draw() {
  column("L", el("colL"), items.filter(it => it.side === "local"));
  column("S", el("colS"), items.filter(it => it.side === "server"));
  el("totL").innerHTML = totals(items.filter(it => it.side === "local"), "L");
  el("totS").innerHTML = totals(items.filter(it => it.side === "server"), "S");
  decide();
  summary();
  const p = picked();
  let up = 0, down = 0;
  for (const it of p) {
    const v = way(it) === "up" ? it.c.l : it.c.s;
    if (v && !v.dir && !it.c.from) way(it) === "up" ? up += v.size : down += v.size;
  }
  const n = p.filter(it => !it.implied).length;
  el("apply").textContent = n ? "Sync " + n.toLocaleString() + (n === 1 ? " change" : " changes") : "Sync";
  el("apply").disabled = busy || !n;
  el("applyinfo").textContent = n ? "↑ " + fmt(up) + " to the server · ↓ " + fmt(down) + " to this drive" : "";
  paint();
}

// What goes out: every ticked item, plus each folder that is itself new or
// deleted whenever something inside it goes too.
function picked() {
  const out = items.filter(it => way(it) && !it.implied), inside = new Set();
  for (const it of out) {
    const parts = it.c.key.split("/");
    for (let i = 1; i < parts.length; i++) inside.add(it.folder + "\u0000" + parts.slice(0, i).join("/"));
  }
  return out.concat(items.filter(it => it.implied && way(it) && inside.has(it.id)));
}

async function loadReview() {
  review = await api("/api/changes");
  flatten();
  draw();
}

async function scan() {
  offset = 0;
  el("log").textContent = "";
  await post("/api/scan");
  poll();
}

el("scan").onclick = scan;
el("apply").onclick = async () => {
  const p = picked();
  let delS = 0, delL = 0;
  for (const it of p) {
    if (it.c.dir) continue;
    if (way(it) === "up" && !it.c.l) delS++;
    if (way(it) === "down" && !it.c.s) delL++;
  }
  const n = p.filter(it => !it.implied).length;
  if ((delS || delL) && !confirm("Sync " + n + " changes?\n\nThis deletes " +
      [delS ? delS + " files on the server" : "", delL ? delL + " files on this drive" : ""]
        .filter(Boolean).join(" and ") + ".")) return;
  offset = 0;
  el("log").textContent = "";
  const r = await post("/api/apply", {picks: p.map(it => ({folder: it.folder, key: it.c.key, way: way(it)}))});
  if (r.error) alert(r.error);
  poll();
};
el("stop").onclick = () => post("/api/stop");
el("resync").onclick = async () => {
  if (!confirm("Rebuild the sync record for every selected folder?\n\n" +
               "Wherever a file differs, the newer copy replaces the older one, " +
               "and files deleted on one side since the last sync come back. " +
               "On these folder sizes it takes a while.")) return;
  offset = 0;
  el("log").textContent = "";
  await post("/api/resync");
  poll();
};
listen(el("colL"));
listen(el("colS"));
el("decide").addEventListener("change", e => {
  const r = e.target;
  if (!r.name || !(r.dataset.i || r.dataset.g)) return;
  for (const it of r.dataset.i ? [items[+r.dataset.i]] : groups[+r.dataset.g].items) {
    if (r.value === it.def) choice.delete(it.id); else choice.set(it.id, r.value);
  }
  draw();
});
el("decide").addEventListener("click", async e => {
  const t = e.target.closest("[data-c]");
  if (t) {
    const g = groups[+t.dataset.c];
    open.set(g.id, t.closest(".cgh").querySelector(".tw").getAttribute("aria-expanded") !== "true");
    return draw();
  }
  const b = e.target.closest("[data-keep]");
  if (!b || busy) return;
  const path = b.dataset.keep, g = (review.copies || []).find(g => g.versions.some(v => v.path === path));
  const rest = g ? g.versions.length - 1 : 0;
  if (!confirm("Keep " + b.dataset.who.toLowerCase() + "?\n\nIt becomes\n  " + (g ? g.base : path) +
               "\n\nand the other " + (rest === 1 ? "version is" : rest + " versions are") +
               " deleted from this drive. Your next sync takes the same change to the server.")) return;
  const r = await post("/api/resolve", {keep: path});
  if (r.error) alert(r.error);
  scan();
});

// -------------------------------------------------------------- job state
// A running sync paints onto the list itself: a file on its way gets a bar,
// a finished one a tick, and a folder row fills up with what is inside it.
// rclone's stats say what is in flight, the log names what finished. The
// column that is moving files also gets bytes, speed and time left on top;
// uploads go under "On this drive", downloads under "On the server".
const live = new Map();   // item id -> fraction done, while in flight
const done = new Set();   // item ids this job finished
const DONE_RE = /^(.+): (?:(?:Multi-thread )?Copied \(.+\)|Deleted|Moved|Updated modification time in destination)$/;
let job = {}, curFolder = "", lastSide = "S";
const toServer = f => /^nc[{:]/.test(f.dstFs || "");

function absorb(lines) {
  for (const line of lines) {
    const f = /^==> (.+?)(?: {2}\(.*\))?$/.exec(line), m = !f && DONE_RE.exec(line);
    if (f) curFolder = f[1];
    else if (m) done.add(curFolder + "\u0000" + m[1].normalize("NFC"));
  }
}

// How far along an item is in the running job: 0..1, or null when not in it.
function frac(it) {
  if (done.has(it.id)) return 1;
  if (live.has(it.id)) return live.get(it.id);
  return job.running && job.kind === "sync" && way(it) ? 0 : null;
}

function overall(s) {
  const pct = s.totalBytes > 0 ? Math.min(100, s.bytes / s.totalBytes * 100) : 0, bits = [];
  if (s.checks) bits.push(s.checks.toLocaleString() + " checked");
  if (s.transfers) bits.push(s.transfers.toLocaleString() + " done");
  if (s.deletes) bits.push(s.deletes.toLocaleString() + " deleted");
  if (s.errors) bits.push('<span class="err">' + s.errors + " errors</span>");
  return '<div class="pline"><span>' + fmt(s.bytes || 0) +
    (s.totalBytes > 0 ? " of " + fmt(s.totalBytes) : "") + "</span><span>" +
    fmt(s.speed || 0) + "/s" + (s.eta ? " &middot; " + dur(s.eta) + " left" : "") + "</span></div>" +
    (s.totalBytes > 0 ? '<div class="pbar"><i style="width:' + pct.toFixed(1) + '%"></i></div>' : "") +
    (bits.length ? '<div class="count" style="margin-top:8px">' + bits.join(" &middot; ") + "</div>" : "");
}

// Updates the bars in place, so the list is not rebuilt under your pointer.
function paint() {
  const s = job.running ? job.stats : null;
  const t = s ? (s.transferring || []).filter(f => f && f.name) : [];
  const side = job.phase === "up" ? "L" : job.phase === "down" ? "S"
    : t.length ? (toServer(t[0]) ? "L" : "S") : lastSide;
  lastSide = side;
  for (const k of ["L", "S"]) {
    const top = el("prog" + k), box = el("col" + k);
    top.className = s && k === side ? "prog on" : "prog";
    top.innerHTML = s && k === side ? overall(s) : "";
    box.querySelectorAll(".row").forEach(row => {
      const cb = row.firstElementChild;
      const list = (cb.dataset.i ? [items[+cb.dataset.i]] : under(box._nodes[+cb.dataset.n]))
        .filter(it => !it.c.dir);
      let n = 0, fin = 0, tot = 0, got = 0;
      for (const it of list) {
        const f = frac(it);
        if (f === null) continue;
        const v = way(it) === "up" ? it.c.l : it.c.s, w = v && !it.c.from ? Math.max(v.size, 1) : 1;
        n++; tot += w; got += f * w; if (f === 1) fin++;
      }
      const rp = row.querySelector(".rp");
      rp.hidden = !n;
      row.classList.toggle("fin", n > 0 && fin === n);
      if (!n) return;
      rp.firstChild.firstChild.style.width = (100 * got / tot).toFixed(1) + "%";
      rp.lastChild.textContent = cb.dataset.i ? (fin ? "✓ done" : Math.floor(100 * got / tot) + "%")
        : fin.toLocaleString() + " of " + n.toLocaleString();
    });
  }
}

let offset = 0, timer = null;
const DOING = {scan: "checking both sides…", sync: "syncing…", resync: "fresh sync…"};

async function poll() {
  const d = await api("/api/joblog?offset=" + offset);
  if (offset === 0) { done.clear(); curFolder = ""; }
  if (d.lines && d.lines.length) {
    absorb(d.lines);
    const pre = el("log");
    if (offset === 0) pre.textContent = "";
    pre.textContent += d.lines.join("\n") + "\n";
    pre.scrollTop = pre.scrollHeight;
  }
  offset = d.total;
  live.clear();
  for (const f of (d.running && d.stats && d.stats.transferring) || []) {
    if (f && f.name) live.set(curFolder + "\u0000" + f.name.normalize("NFC"),
                              f.size > 0 ? f.bytes / f.size : (f.percentage || 0) / 100);
  }
  job = d;
  const was = busy;
  busy = d.running;
  el("scan").disabled = busy; el("stop").disabled = !busy; el("resync").disabled = busy;
  el("jobstate").innerHTML = busy
    ? '<span class="spin"></span> ' + (DOING[d.kind] || "running")
    : (d.rc ? '<span class="err">' + ({scan: "check", sync: "sync", resync: "fresh sync"}[d.kind] || "run") +
       " failed (exit " + d.rc + ") — see the log</span>" : "");
  if (busy && !timer) timer = setInterval(poll, 700);
  if (!busy && timer) { clearInterval(timer); timer = null; }
  if (was && !busy) {
    done.clear();
    if (d.rc) el("logbox").open = true;
    refreshRuns();
    if (d.kind === "resync") { scan(); return; }
    await loadReview();
  } else if (was !== busy) draw();
  else paint();
}

// ----------------------------------------------------------- folder picker
async function load(path) {
  const n = node(path);
  const d = await api("/api/ls?path=" + encodeURIComponent(path));
  if (d.error) { flash(d.error, true); return; }
  n.children = d.dirs;
  n.loaded = true;
}

function render() {
  const t = el("tree");
  t.innerHTML = "";
  const walk = (path, depth) => {
    const n = node(path);
    for (const name of n.children) {
      const full = path ? path + "/" + name : name;
      const c = node(full);
      const row = document.createElement("div");
      row.className = "row";
      row.style.paddingLeft = (14 + depth * 16) + "px";

      const tw = document.createElement("span");
      tw.className = "tw";
      tw.textContent = c.open ? "▾" : "▸";
      tw.onclick = async () => {
        c.open = !c.open;
        if (c.open && !c.loaded) { tw.textContent = "…"; await load(full); }
        render();
      };
      row.appendChild(tw);

      const cb = document.createElement("input");
      cb.type = "checkbox";
      cb.checked = selected.has(full);
      cb.onchange = () => {
        if (cb.checked) {
          for (const s of [...selected]) {
            if (full.startsWith(s + "/") || s.startsWith(full + "/")) selected.delete(s);
          }
          selected.add(full);
        } else selected.delete(full);
        render();
      };
      row.appendChild(cb);

      const nm = document.createElement("span");
      nm.className = "nm";
      nm.textContent = name;
      row.appendChild(nm);

      if (lastRuns[full]) {
        const lr = document.createElement("span");
        lr.className = "lr";
        lr.textContent = "synced " + lastRuns[full];
        row.appendChild(lr);
      }

      const sz = document.createElement("span");
      sz.className = "sz";
      if (c.size === null) {
        const b = document.createElement("button");
        b.textContent = "size";
        b.onclick = async () => {
          b.textContent = "…"; b.disabled = true;
          const d = await api("/api/size?path=" + encodeURIComponent(full));
          c.size = d.error ? -1 : d.bytes;
          c.count = d.count;
          render();
        };
        sz.appendChild(b);
      } else if (c.size < 0) {
        sz.textContent = "—";
      } else {
        sz.textContent = fmt(c.size) + "  ·  " + c.count + " files";
      }
      row.appendChild(sz);
      t.appendChild(row);

      if (c.open) walk(full, depth + 1);
    }
  };
  walk("", 0);
  if (!node("").children.length) {
    t.innerHTML = '<div class="row"><span class="count">nothing found on the server</span></div>';
  }
  const bad = overlap();
  el("sel").innerHTML = selected.size + " selected" +
    (bad ? ' <span class="err">— ' + bad[0] + " contains " + bad[1] + "</span>" : "");
  el("save").disabled = !!bad;
}

function overlap() {
  const a = [...selected];
  for (const x of a) for (const y of a)
    if (x !== y && y.startsWith(x + "/")) return [x, y];
  return null;
}

function flash(msg, bad) {
  el("pickmsg").textContent = msg;
  el("pickmsg").className = bad ? "err" : "count";
}

async function refreshRuns() {
  const d = await api("/api/state");
  lastRuns = d.lastRuns || {};
  render();
}

el("save").onclick = async () => {
  const d = await post("/api/selection", {paths: [...selected].sort()});
  if (!d.error) { saved = d.count; summary(); }
  flash(d.error ? d.error : "Saved " + d.count + (d.count === 1 ? " folder." : " folders."), !!d.error);
  if (!d.error && !busy) scan();
};

(async function init() {
  const d = await api("/api/state");
  el("remote").textContent = d.remote || "(no rclone.conf)";
  el("repo").textContent = d.repo;
  lastRuns = d.lastRuns || {};
  selected = new Set(d.selection || []);
  saved = selected.size;
  const w = [];
  if (!d.hasRclone) w.push("rclone is not installed — install it, then reload this page.");
  if (!d.hasConf) w.push("No rclone.conf yet. Run:  bash _sync/setup.sh");
  if (!d.mounted) w.push("The drive does not look mounted — .repo-id is missing. New here? Run:  bash _sync/setup.sh");
  if (w.length) el("warn").innerHTML = '<div class="note">' + w.join("<br>") + "</div>";
  await loadReview();
  await poll();
  const ready = d.hasConf && d.hasRclone && d.mounted;
  if (ready && !busy && (d.selection || []).length) scan();
  if (d.hasConf && d.hasRclone) { await load(""); render(); }
  else el("tree").innerHTML = '<div class="row"><span class="count">nothing to show yet</span></div>';
})();
</script></body></html>
"""

# ------------------------------------------------------------------ server


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "ncweb"

    def log_message(self, *a):  # quiet
        pass

    # -- guards ----------------------------------------------------------
    def _ok_host(self):
        host = (self.headers.get("Host") or "").split(":")[0]
        return host in ("127.0.0.1", "localhost", "[::1]", "::1")

    def _q(self):
        return urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)

    def _authed(self):
        return self._q().get("t", [""])[0] == TOKEN

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(data)

    def _json(self, obj, code=200):
        self._send(code, json.dumps(obj))

    def _body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if not n:
            return {}
        try:
            return json.loads(self.rfile.read(n).decode("utf-8"))
        except ValueError:
            return {}

    # -- routes ----------------------------------------------------------
    def do_GET(self):
        if not self._ok_host():
            return self._send(403, "forbidden", "text/plain")
        path = urllib.parse.urlparse(self.path).path
        if path == "/" and self._authed():
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if not self._authed():
            return self._send(403, "bad or missing token", "text/plain")

        if path == "/api/state":
            sel = read_selection()
            url = ""
            if os.path.exists(CONF):
                with open(CONF, encoding="utf-8") as fh:
                    for line in fh:
                        if line.startswith("url ="):
                            url = line.split("=", 1)[1].strip()
            runs = {p: last_run(p) for p in sel if last_run(p)}
            return self._json({
                "repo": REPO, "remote": url, "selection": sel,
                "lastRuns": runs, "hasConf": os.path.exists(CONF),
                "hasRclone": have_rclone(), "mounted": os.path.exists(REPO_ID),
            })

        if path == "/api/ls":
            p = self._q().get("path", [""])[0]
            if not os.path.exists(CONF):
                return self._json({"error": "no rclone.conf"})
            try:
                rc, out, err = rclone(["lsjson", "nc:" + p, "--dirs-only"], timeout=120)
            except subprocess.TimeoutExpired:
                return self._json({"error": "server timed out listing " + (p or "/")})
            if rc != 0:
                return self._json({"error": (err or "rclone failed").strip()[:400]})
            try:
                items = json.loads(out or "[]")
            except ValueError:
                return self._json({"error": "could not parse rclone output"})
            names = sorted([i["Name"] for i in items if i.get("IsDir")],
                           key=str.lower)
            return self._json({"dirs": names})

        if path == "/api/size":
            p = self._q().get("path", [""])[0]
            try:
                rc, out, err = rclone(["size", "nc:" + p, "--json"], timeout=600)
            except subprocess.TimeoutExpired:
                return self._json({"error": "timed out"})
            if rc != 0:
                return self._json({"error": (err or "failed").strip()[:200]})
            try:
                d = json.loads(out)
            except ValueError:
                return self._json({"error": "bad output"})
            return self._json({"bytes": d.get("bytes", 0), "count": d.get("count", 0)})

        if path == "/api/changes":
            folders = REVIEW["folders"]
            return self._json({
                "folders": [folders[f] for f in read_selection() if f in folders],
                "copies": REVIEW["copies"], "more": REVIEW["more"], "at": REVIEW["at"]})

        if path == "/api/joblog":
            try:
                off = int(self._q().get("offset", ["0"])[0])
            except ValueError:
                off = 0
            lines, total, running, rc, stats, kind, phase = JOB.tail(off)
            return self._json({"lines": lines, "total": total, "running": running,
                               "rc": rc, "stats": stats, "kind": kind, "phase": phase})

        return self._send(404, "not found", "text/plain")

    def do_POST(self):
        if not self._ok_host():
            return self._send(403, "forbidden", "text/plain")
        if not self._authed():
            return self._send(403, "bad or missing token", "text/plain")
        path = urllib.parse.urlparse(self.path).path
        body = self._body()

        if path == "/api/selection":
            paths = [str(p).strip().strip("/") for p in body.get("paths", [])]
            paths = [p for p in paths if p]
            bad = overlaps(paths)
            if bad:
                return self._json({"error": "%s contains %s - pick one" % bad})
            write_selection(paths)
            return self._json({"count": len(paths)})

        if path in ("/api/scan", "/api/apply", "/api/resync"):
            if not os.path.exists(REPO_ID):
                return self._json({"error": "drive not mounted"}, 400)
            if path == "/api/scan":
                return self._json({"started": JOB.start("scan", scan_task, log=False)})
            if path == "/api/resync":
                return self._json({"started": JOB.start("resync", resync_task)})
            sel, picks = set(read_selection()), {}
            for p in body.get("picks", []):
                if not isinstance(p, dict) or p.get("folder") not in sel or \
                        p.get("way") not in ("up", "down") or not isinstance(p.get("key"), str):
                    return self._json({"error": "bad pick: %r" % (p,)}, 400)
                picks.setdefault(p["folder"], {})[p["key"]] = p["way"]
            return self._json({"started": JOB.start(
                "sync", lambda job: apply_task(job, picks))})

        if path == "/api/resolve":
            if JOB.running:
                return self._json({"error": "a sync is running"}, 409)
            try:
                err = keep_version(str(body.get("keep", "")))
            except OSError as exc:
                err = str(exc)
            return self._json({"error": err} if err else {"ok": True}, 400 if err else 200)

        if path == "/api/stop":
            JOB.stop()
            return self._json({"ok": True})

        return self._send(404, "not found", "text/plain")


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    if not os.path.isdir(SELF):
        sys.exit("cannot locate _sync directory")
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()

    httpd = Server(("127.0.0.1", port), Handler)
    url = "http://127.0.0.1:%d/?t=%s" % (port, TOKEN)
    print("ncweb serving at:\n  %s\n" % url)
    print("Only this machine can reach it. Ctrl-C to stop.")
    if "--no-browser" not in sys.argv:
        threading.Timer(0.4, lambda: webbrowser.open(url)).start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")


if __name__ == "__main__":
    main()
